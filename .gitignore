# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env
.env*.local

# build info
tsconfig.tsbuildinfo
_to_delete/

# Credentials that are not .env files.
# `.env*` above does not catch a stray .txt.
*.key
*.secret
META_TOKEN_KEY*

# Local scratch - one-off scripts, patches, and real dealer data used while
# debugging. malabarinventory.csv is a customer's actual inventory export:
# 21 real VINs with prices and descriptions carrying their phone and address.
# Once it is in history it is permanent, so it never goes in.
clear-malabar.js
diagnose-*.js
malabarinventory.csv
*.patch
